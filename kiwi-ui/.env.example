# Kiwi UI configuration. Values are baked in at build time (`npm run build`).

# --- Backend ------------------------------------------------------------------
# Kiwi backend used for API calls.
VITE_BASE_PATH="http://localhost:3000"
# Kiwi backend used for the Google sign-in redirect (usually the same URL).
VITE_BACKEND_URL="http://localhost:3000"

# --- Sign-in ------------------------------------------------------------------
# Password login is on by default. Set to true for Google-only deployments
# (and enable Google below, or nobody can sign in).
VITE_DISABLE_PASSWORD_LOGIN=false
# Show "Continue with Google". Requires GOOGLE_CLIENT_ID on the backend.
VITE_ENABLE_GOOGLE_LOGIN=false

# --- Branding / institution (all optional; neutral defaults apply) -----------
# Name of the institution running this instance. Empty shows plain "Kiwi".
VITE_INSTITUTION_NAME=""
# Support address shown to users. Empty hides support prompts.
VITE_SUPPORT_EMAIL=""
# Email domain whose accounts sign in with Google, e.g. "example.edu". In
# Admin -> User Management these accounts are whitelisted, not given passwords.
VITE_SSO_EMAIL_DOMAIN=""
# Square logo image, as a URL path under public/ (default /assets/images/kiwi-mark.svg).
VITE_LOGO_URL=""
# Wordmark for the nav and sign-in pages, used as a CSS mask so only its shape
# matters. Empty (the default) shows the square logo in colour next to "Kiwi";
# /assets/images/kiwi-logo.svg is a one-colour Kiwi wordmark.
VITE_LOGO_LIGHT_URL=""

# --- Research consent -----------------------------------------------------------
# When set, users must accept this document (PDF URL) before using the app.
# Leave empty to disable the consent gate.
VITE_CONSENT_FORM_URL=""
