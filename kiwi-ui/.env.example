VITE_GOOGLE_API_ID=""
VITE_DISABLE_PASSWORD_LOGIN=false
VITE_BACKEND_URL="http://localhost:3000"

# --- Branding / institution (all optional; neutral defaults apply) ---
# Display name of the institution running this instance.
VITE_INSTITUTION_NAME=""
# Support address shown to users. Leave empty to hide support prompts.
VITE_SUPPORT_EMAIL=""
# Public URL of this deployment. Defaults to the browser's origin.
VITE_FRONTEND_URL=""
# Email domain routed to SSO instead of password login, e.g. "example.edu".
VITE_SSO_EMAIL_DOMAIN=""
# Logo assets served from public/.
VITE_LOGO_URL=""
VITE_LOGO_LIGHT_URL=""
# URL of the consent document shown on /consent. Empty = no consent form.
VITE_CONSENT_FORM_URL=""
