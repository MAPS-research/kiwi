DATABASE_URL="postgresql://kiwi:kiwi@localhost:5432/kiwi"
PORT=3000
# JWT Configuration
# Option 1: RS256 (Recommended for production - asymmetric keys)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then base64 encode: base64 < private.pem | tr -d '\n'
# If not set, ephemeral keys are auto-generated on startup (development only)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Option 2: HS256 (Fallback - only used if RS256 keys not set)
JWT_SECRET="DO NOT USE THIS VALUE. INSTEAD, CREATE A COMPLEX SECRET."
SESSION_SECRET="SESSION SECRET, ALSO CREATE A COMPLEX SECRET."

# Admin account created by `npx prisma db seed`. Leave the password empty to
# have one generated and printed once when the seed finishes.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Google sign-in (optional). Password login works without it; Google is enabled
# only when GOOGLE_CLIENT_ID is set. Also set VITE_ENABLE_GOOGLE_LOGIN=true in
# kiwi-ui to show the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google"
# Comma-separated Google Workspace domains allowed to sign in, or "*".
GOOGLE_DOMAIN="*"
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_EMBEDDING_MODEL="text-embedding-3-small"
LLM_CHAT_MODEL="gpt-3.5-turbo"
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_VISION_MODEL="qwen-vl-max-2024-08-09"
QWEN_CHAT_MODEL="qwen-plus-0806"
QWEN_EMBEDDING_MODEL="text-embedding-v2"
UNSTRUCTURED_API_URL=http://localhost:9500
FRONTEND_URL=http://localhost:3001
REDIS_PASSWORD="kiwi"
REDIS_HOST="localhost"
REDIS_PORT=6379
BASE_URL="localhost:3000"
SERVER_URL="http://localhost:3000"
LLM_TOKEN_LIMIT=100000
# Enables POST /auth/dev, which creates an ADMIN user for anyone who calls it.
# Local development only; it is always refused when NODE_ENV=production.
DEV_AUTH=false
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET="kiwi"
OSS_REGION="us-east-1"
OSS_ENDPOINT=""
OSS_VENDOR="minio"
COMPETITION_API_URL="http://localhost:8005"
CODEGEN_API_URL="http://localhost:8001"
# Amazon SES SMTP Configuration
AWS_SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=""
AWS_SES_SMTP_PASSWORD=""
AWS_SES_FROM_EMAIL="noreply@yourdomain.com"
AWS_SES_FROM_NAME="Kiwi Platform"
AWS_SES_REPLY_TO_EMAIL="support@yourdomain.com"
AWS_SES_REPLY_TO_NAME="Kiwi Platform Support"
# Set to true to log emails instead of sending (useful for development)
EMAIL_TEST_MODE=false