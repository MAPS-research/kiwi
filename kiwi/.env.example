# Kiwi backend configuration.
# Copy to `.env` and fill in at least LLM_API_KEY. The defaults below match the
# local services in compose.yml. Change every secret before any non-local use;
# see SECURITY.md.

# --- Server -------------------------------------------------------------------
PORT=3000
# Public URL of this backend (OAuth discovery metadata, MCP resource URLs).
SERVER_URL="http://localhost:3000"
BASE_URL="localhost:3000"
# Comma-separated frontend origins allowed by CORS and as login redirects.
# The first one is the default redirect after sign-in.
FRONTEND_URL=http://localhost:3001
# Set to the backend's public domain in production: enables secure cookies and
# trusts the reverse proxy.
# API_DOMAIN="api.kiwi.example.edu"

# --- Database and Redis (compose.yml) ----------------------------------------
DATABASE_URL="postgresql://kiwi:kiwi@localhost:5432/kiwi"
REDIS_HOST="localhost"
REDIS_PORT=6379
# The local Redis in compose.yml has no password.
REDIS_PASSWORD=""

# --- Auth ---------------------------------------------------------------------
# Sign tokens with RS256 so external services can verify them via
# /.well-known/jwks.json. Without both keys, tokens are HS256 with JWT_SECRET
# and JWKS verification will not work. See docs/jwt-configuration.md.
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 < private.pem | tr -d '\n'
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_SECRET="DO NOT USE THIS VALUE. INSTEAD, CREATE A COMPLEX SECRET."
SESSION_SECRET="SESSION SECRET, ALSO CREATE A COMPLEX SECRET."
# Encrypts stored MCP server credentials. Falls back to SESSION_SECRET.
# ENCRYPTION_KEY=""

# Admin account created by `npx prisma db seed`. Leave the password empty to
# have one generated and printed once when the seed finishes.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Enables POST /auth/dev, which creates an ADMIN user for anyone who calls it.
# Local development only; it is always refused when NODE_ENV=production.
DEV_AUTH=false

# Google sign-in (optional). Password login works without it; Google is enabled
# only when GOOGLE_CLIENT_ID is set. Also set VITE_ENABLE_GOOGLE_LOGIN=true in
# kiwi-ui to show the button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google"
# Comma-separated Google Workspace domains allowed to sign in, or "*".
# Only Workspace accounts are checked; personal Gmail accounts are not
# restricted by this setting.
GOOGLE_DOMAIN="*"

# Lifetime of tokens issued to embedded Kiwi Apps, in seconds (default 3600).
# APP_TOKEN_TTL_SECONDS=3600

# --- LLM providers ------------------------------------------------------------
# "openai": any OpenAI-compatible endpoint. The engine is configured for
# reasoning models: it sends max_completion_tokens and no temperature.
LLM_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_CHAT_MODEL="gpt-5.4-mini"
LLM_EMBEDDING_MODEL="text-embedding-3-small"
# Per-user token quota.
LLM_TOKEN_LIMIT=100000

# "qwen" (optional): an OpenAI-compatible endpoint that takes the classic
# temperature/max_tokens parameters. Leave QWEN_API_KEY empty to disable it.
# Qwen embeddings are registered as 1024-dimensional (bge-m3); set
# QWEN_EMBEDDING_MODEL to a model with that output size, or register another
# model as described in docs/embeddings.md.
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_CHAT_MODEL="qwen-plus-0806"
QWEN_VISION_MODEL="qwen-vl-max-2024-08-09"
QWEN_EMBEDDING_MODEL=""
# Embedding provider used when a request doesn't choose one: openai | qwen
# EMBEDDING_PROVIDER=openai

# --- Documents ----------------------------------------------------------------
# Parser for uploaded documents: "xberg" (default) or "unstructured".
# The app refuses to boot if the chosen parser's URL is not set.
# Xberg, which compose.yml starts.
PARSER=xberg
XBERG_API_URL=http://localhost:8002
# Optional Xberg tuning; defaults shown.
# XBERG_MAX_CHARACTERS=1024
# XBERG_CHUNK_OVERLAP=128
# XBERG_EXTRACTION_TIMEOUT_SECS=1200

# Unstructured instead: uncomment its service in compose.yml.
# PARSER=unstructured
# UNSTRUCTURED_API_URL=http://localhost:9500

# Object storage. These values match the MinIO service in compose.yml.
OSS_VENDOR="minio"
OSS_ENDPOINT="http://localhost:9000"
OSS_ACCESS_KEY_ID="kiwi"
OSS_ACCESS_KEY_SECRET="kiwikiwi"
OSS_BUCKET="kiwi"
OSS_REGION="us-east-1"

# --- Email --------------------------------------------------------------------
# Log emails instead of sending them. Set to false once SMTP is configured.
EMAIL_TEST_MODE=true
AWS_SES_SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=""
AWS_SES_SMTP_PASSWORD=""
AWS_SES_FROM_EMAIL="noreply@example.edu"
AWS_SES_FROM_NAME="Kiwi"
AWS_SES_REPLY_TO_EMAIL="support@example.edu"
AWS_SES_REPLY_TO_NAME="Kiwi Support"
# Shown in the welcome email. All optional.
# INSTITUTION_NAME="Example University"
# SUPPORT_EMAIL="kiwi-support@example.edu"
# ONBOARDING_GUIDE_URL="https://example.edu/kiwi-guide"

# --- Integrations -------------------------------------------------------------
# Competition service (optional).
COMPETITION_API_URL="http://localhost:8005"

# --- Debugging ----------------------------------------------------------------
# Log assembled prompts and other debug-level output.
# LOG_LEVEL_DEBUG=true
